# ─────────────────────────────────────────────────────────────
# SilicaFlow — .gitignore
# ─────────────────────────────────────────────────────────────
# Source-of-truth files are tracked. Generated outputs are not.
# See AGENTS.md for the full source-of-truth vs. disposable policy.
# ─────────────────────────────────────────────────────────────

# ── Disposable outputs (regenerated by tool runs) ────────────
work/
logs/
reports/

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# ── OS artifacts ─────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ── Editor / IDE ─────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
.settings/

# ── EDA tool artifacts (large, binary, regenerable) ──────────
# Verilator build artifacts
*.d
*.dat
*.vcd
*.fst

# Yosys
*.blif
*.edif

# OpenROAD / physical
*.odb
*.spef
*.sdf

# KLayout
*.lyrdb
*.lydrc

# Simulation
*.vvp
*.shm/
*.fsdb
*.wlf
*.ucdb

# ── Technology files (tracked via libs/ and pdks/ READMEs,
#    but actual .lib/.lef/.gds are often too large for git) ───
# Uncomment these if your tech files are large:
# libs/*.lib
# pdks/**/*.lef
# pdks/**/*.gds

# ── Orchestrator runtime state ───────────────────────────────
orchestrator/state/
